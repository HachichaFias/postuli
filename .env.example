# Copy to .env.local. Only src/server/env.ts reads these (ADR 008).
# Local values come from `pnpm db:start` (it prints the API URL and the keys) — ADR 009, ADR 011.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

